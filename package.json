{
  "name": "svelte-project-template",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "lint": "svelte-kit sync && prettier --check src && svelte-check --tsgo --fail-on-warnings && eslint --max-warnings 0",
    "format": "eslint --fix && prettier --write .",
    "precommit": "lint-staged"
  },
  "lint-staged": {
    "*.(js|ts|svelte)": [
      "eslint --max-warnings 0 --ext js --no-ignore"
    ],
    "*.(svelte|ts)": [
      "svelte-check --tsgo --fail-on-warnings"
    ],
    "*.(ts|svelte|json|scss|md)": [
      "prettier --check"
    ]
  },
  "devDependencies": {
    "@babylonjs/core": "^9.27.1",
    "@babylonjs/gui": "^9.27.1",
    "@babylonjs/gui-editor": "^9.27.1",
    "@babylonjs/inspector": "^9.27.1",
    "@babylonjs/loaders": "^9.27.1",
    "@babylonjs/materials": "^9.27.1",
    "@babylonjs/serializers": "^9.27.1",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babylonjs-gltf2interface": "^9.27.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "6",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
